        "url": "https://images.pexels.com/photos/6740136/pexels-photo-6740136.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
      }
    ]
  },
  "testing_rules": {
    "data_testid": "CRITICAL: All interactive and key informational elements MUST include a data-testid attribute. Convention: kebab-case, role-based. Examples: data-testid='onboarding-next-button', data-testid='health-score-value', data-testid='food-scan-button'."
  }
}