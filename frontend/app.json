{
  "expo": {
    "name": "Leanly",
    "slug": "leanly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leanly",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leanly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan meals to track calories automatically",
        "NSPhotoLibraryUsageDescription": "Upload meal photos for AI analysis"
      }
    },
    "android": {
      "package": "com.leanly.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2B4C3B"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan meals to track calories automatically"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload meal photos for AI analysis",
          "cameraPermission": "Scan meals to track calories automatically"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
